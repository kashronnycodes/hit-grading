{
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:mobile": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/devMobile.ts",
    "dev:mobile:no-hmr": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/devMobile.ts --no-hmr",
    "dev:api": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs watch server/src/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "build:api": "tsc -p tsconfig.server.json",
    "test:identification": "node --import tsx --test server/tests/*.test.ts",
    "sync:pokemon": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/syncPokemonMetadata.ts",
    "pokemon:sync:diagnose": "node --use-system-ca ./node_modules/tsx/dist/cli.mjs scripts/diagnosePokemonSync.ts",
    "pokemon:cache:stats": "node ./node_modules/tsx/dist/cli.mjs scripts/pokemonCacheStats.ts",
    "network:doctor": "node ./node_modules/tsx/dist/cli.mjs scripts/networkDoctor.ts",
    "preview": "vite preview --host 0.0.0.0",
    "start:api": "node dist-server/index.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "@vitejs/plugin-react": "latest",
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "lucide-react": "latest",
    "multer": "^1.4.5-lts.2",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "^0.34.2",
    "tesseract.js": "^6.0.1",
    "uuid": "^11.1.0",
    "vite": "latest",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
